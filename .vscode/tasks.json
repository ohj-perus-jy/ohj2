{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "zensical: serve",
      "type": "shell",
      "command": "./zensical/run.sh",
      "args": ["36742"],
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": {
        "owner": "zensical",
        "pattern": [
          {
            "regexp": "Serving \\S+ on (http://\\S+)",
            "kind": "file",
            "file": 1,
            "message": 0
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "Serving .* on http"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
