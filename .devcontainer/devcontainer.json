{
	"name": "Ohj2",
	// Kuvassa on Rust, jolla convert.py asentaa svgbob_cli:n bob-kaavioita varten.
	"image": "ghcr.io/ohj-perus-jy/ohj-mdbook-tooling:devcontainer-latest",
	"features": {
		"ghcr.io/devcontainers/features/git:1": {},
		"ghcr.io/devcontainers/features/docker-outside-of-docker:1": {},
		"ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
	},

	"mounts": [
		"source=claude-code-config,target=/home/vscode/.claude,type=volume"
	],

	// 8001 = zensical/run.sh
	"forwardPorts": [8001],

	"customizations": {
		"vscode": {
			"extensions": [
				"dnut.rewrap-revived",
				"yzhang.markdown-all-in-one"
			]
		}
	},

	// Työkalut (submodule) ja zensical/.venv valmiiksi; run.sh tekisi saman ensimmäisellä ajolla.
	"postCreateCommand": "sudo chown -R vscode:vscode /home/vscode/.claude && ln -sf /home/vscode/.claude/.claude.json /home/vscode/.claude.json && git submodule update --init && ./zensical/tyokalut/setup.sh"
}
