<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fi.jyu.ohj2.esimerkit.viitteidenkorjaaminen.MainController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <children>
      <HBox spacing="20.0">
         <children>
            <VBox spacing="20.0">
               <children>
                  <Label text="Tehtävät" />
                  <TableView fx:id="tehtavatTableView" prefHeight="200.0" />
                  <HBox alignment="TOP_RIGHT">
                     <children>
                        <Button fx:id="muokkaaTehtavaButton" mnemonicParsing="false" onAction="#kasitteleMuokkaaTehtava" text="Muokkaa" />
                     </children>
                  </HBox>
               </children>
            </VBox>
            <Separator orientation="VERTICAL" prefHeight="200.0" />
            <VBox spacing="20.0">
               <children>
                  <Label text="Kategoriat" />
                  <ListView fx:id="kategoriatListView" prefHeight="200.0" prefWidth="200.0" />
                  <HBox alignment="TOP_RIGHT" spacing="10.0">
                     <children>
                        <Button fx:id="lisaaKategoriaButton" mnemonicParsing="false" onAction="#kasitteleLisaaKategoria" text="Lisää" />
                        <Button fx:id="muokkaaKategoriaButton" mnemonicParsing="false" onAction="#kasitteleMuokkaaKategoria" text="Muokkaa" />
                        <Button fx:id="poistaKategoriaButton" mnemonicParsing="false" onAction="#kasittelePoistaKategoria" text="Poista" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
      </HBox>
   </children>
</VBox>
